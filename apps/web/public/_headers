# Cloudflare Workers static assets headers.
# The ffmpeg core is fetched from unpkg (connect-src) and run from blob: URLs;
# WebAssembly needs 'wasm-unsafe-eval'. style-src allows inline style
# attributes (progress bars). No inline scripts: the theme bootstrap is a file.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' blob: https://unpkg.com; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
